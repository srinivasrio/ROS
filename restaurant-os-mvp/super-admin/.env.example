# ==========================================
# Dine In One Super Admin - Environment Variables Template
# ==========================================
# Copy this file to super-admin/.env.local and populate with your environment-specific credentials.
# NEVER commit .env.local or real secrets to Git.

# ------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------
# Mandatory: Cryptographically random secret string of at least 32 characters.
# Generate via: openssl rand -base64 48
JWT_SECRET=

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------
# Cloudflare R2 Storage Configuration
# ------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ------------------------------------------
# Application URLs
# ------------------------------------------
NEXT_PUBLIC_RESTAURANT_APP_URL=

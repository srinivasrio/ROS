# ==========================================
# Dine In One - Environment Variables Template
# ==========================================
# Copy this file to .env.local and populate with your environment-specific credentials.
# NEVER commit .env.local or real secrets to Git.

# ------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------
# Mandatory: Cryptographically random secret string of at least 32 characters.
# Generate via: openssl rand -base64 48
JWT_SECRET=

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PRIMARY_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PRIMARY_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Primary Supabase stack JWT secret (NOT the app JWT_SECRET). Signs 15-min Realtime tokens. Leave unset to keep realtime on the anon key.
SUPABASE_REALTIME_JWT_SECRET=

# ------------------------------------------
# Cloudflare R2 Storage Configuration
# ------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ------------------------------------------
# Amazon SES Email Service Configuration
# ------------------------------------------
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# ------------------------------------------
# Application URLs
# ------------------------------------------
NEXT_PUBLIC_SUPER_ADMIN_URL=

# ------------------------------------------
# Maintenance & Debug Scripts (Optional)
# ------------------------------------------
# Used by debug-login.mjs and debug-login2.mjs
DEBUG_USER_EMAIL=
DEBUG_USER_PASSWORD=

# Used by update_phone.js
UPDATE_USER_ID=
UPDATE_USER_PHONE=
UPDATE_USER_PASSWORD=

# Used by reset_pass.js
RESET_USER_ID=
RESET_USER_PASSWORD=

# Used by verify-password.mjs
TEST_PASSWORD_HASH=
TEST_PASSWORD=
